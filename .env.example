# ============================================================
# BCRLS site + admin API configuration
# Copy to `.env` and edit. Never commit the real .env file.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

# HTTP port of the Node server (serves the static site, /admin and /api)
PORT=4000
NODE_ENV=development

# Repository root that is served as the static site
SITE_ROOT=.

# PostgreSQL connection string
DATABASE_URL=postgres://bcrls:bcrls@127.0.0.1:5432/bcrls

# Signing key for admin JWTs (>= 32 chars). Required in production;
# a random key is generated (and discarded on restart) in development.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Where uploaded images are kept: local | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=server/uploads
# cloudinary://<api_key>:<api_secret>@<cloud_name>   (production only)
CLOUDINARY_URL=

# Origin the browser talks to (used for CORS when the API is on another host)
PUBLIC_ORIGIN=http://localhost:4000

# Static hardcoded admins that bypass database authentication entirely
HARDCODED_ADMIN_1_EMAIL=admin1@gmail.com
HARDCODED_ADMIN_1_PASSWORD=Admin1234@
HARDCODED_ADMIN_2_EMAIL=admin2@gmail.com
HARDCODED_ADMIN_2_PASSWORD=ADmin1234@
